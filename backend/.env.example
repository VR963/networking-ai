# CV2.0 Platform — Environment Variables
# Copy this file to .env and fill in your values

# --- Required: AI Provider ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Required: Database ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# --- Optional: Application ---
APP_ENV=development                     # development | staging | production
WORKERS=4                               # Uvicorn worker count

# --- Optional: Security ---
MASTER_API_KEY=                          # API key for admin/Master AI endpoints
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# --- Optional: Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60                # General endpoints
RATE_LIMIT_AI_PER_MINUTE=20             # AI-heavy endpoints (chat, negotiation)
MAX_CONCURRENT_AI_CALLS=10              # Max parallel Anthropic API calls

# --- Optional: Cache ---
CACHE_TTL_SECONDS=300                   # LRU cache TTL (5 min default)
CACHE_MAX_SIZE=1000                     # Max cached entries
