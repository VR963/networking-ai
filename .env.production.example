# Production Environment Configuration for Networking AI Platform
# Copy this file to .env.production and fill in actual values
# NEVER commit actual .env.production to version control

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=warning
SECRET_KEY=<GENERATE_SECURE_RANDOM_KEY_64_CHARS>
JWT_SECRET_KEY=<GENERATE_SECURE_RANDOM_KEY_64_CHARS>

# Server
WORKERS=8
PORT=8000
WORKER_CLASS=uvicorn.workers.UvicornWorker
WORKER_CONNECTIONS=1000
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=50
TIMEOUT=30
GRACEFUL_TIMEOUT=30
KEEPALIVE=5

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
POSTGRES_HOST=postgres-service
POSTGRES_PORT=5432
POSTGRES_DB=networking_ai
POSTGRES_USER=<SECURE_USERNAME>
POSTGRES_PASSWORD=<SECURE_PASSWORD_32_CHARS>
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Connection Pooling
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_HOST=redis-service
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=<SECURE_PASSWORD_32_CHARS>
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# Redis Connection Pool
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_SOCKET_KEEPALIVE=true

# ============================================================================
# API KEYS & EXTERNAL SERVICES
# ============================================================================
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>

# Monitoring & Error Tracking
SENTRY_DSN=<YOUR_SENTRY_DSN>
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HTTPS_ONLY=true
SECURE_COOKIES=true
CSRF_ENABLED=true

# CORS
ALLOWED_ORIGINS=https://networking-ai.com,https://www.networking-ai.com,https://app.networking-ai.com
ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
ALLOWED_HEADERS=DNT,Keep-Alive,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization

# Session
SESSION_COOKIE_NAME=session_id
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=strict
SESSION_MAX_AGE=3600

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_WEBSOCKET=true
ENABLE_MASTER_AGENT=true
ENABLE_METRICS=true
ENABLE_RATE_LIMITING=true
ENABLE_API_DOCS=false  # Disable in production
ENABLE_DEBUG_ENDPOINTS=false

# ============================================================================
# WEBSOCKET CONFIGURATION
# ============================================================================
WEBSOCKET_MAX_CONNECTIONS=10000
WEBSOCKET_PING_INTERVAL=30
WEBSOCKET_PING_TIMEOUT=10
WEBSOCKET_MAX_MESSAGE_SIZE=10485760  # 10MB
WEBSOCKET_COMPRESSION=true

# ============================================================================
# WORKER CONFIGURATION
# ============================================================================
WORKER_CONCURRENCY=4
WORKER_MAX_TASKS_PER_CHILD=1000
WORKER_PREFETCH_MULTIPLIER=4
WORKER_TASK_ACKS_LATE=true
WORKER_TASK_REJECT_ON_WORKER_LOST=true

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=10000
RATE_LIMIT_STRATEGY=fixed-window

# Authentication Endpoints (stricter limits)
AUTH_RATE_LIMIT_PER_MINUTE=5
AUTH_RATE_LIMIT_PER_HOUR=20

# ============================================================================
# CACHING CONFIGURATION
# ============================================================================
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=300
CACHE_MAX_SIZE=10000
CACHE_EVICTION_POLICY=lru

# ============================================================================
# PLATFORM HEALTH MONITORING
# ============================================================================
PLATFORM_HEALTH_CHECK_INTERVAL=300
PLATFORM_HEALTH_THRESHOLD=69
PLATFORM_HEALTH_WARNING_THRESHOLD=75

# Master Agent
MASTER_AGENT_ENABLED=true
MASTER_AGENT_CHECK_INTERVAL=3600
MASTER_AGENT_AUTO_INTERVENTION=true

# ============================================================================
# MONITORING & METRICS
# ============================================================================
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics
METRICS_INCLUDE_HOST_INFO=true

# Prometheus
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_FORMAT=json
LOG_TIMESTAMP_FORMAT=iso
LOG_FILE=/app/logs/app.log
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=10
LOG_ROTATION=daily

# ============================================================================
# FILE UPLOADS
# ============================================================================
UPLOAD_MAX_SIZE=104857600  # 100MB
UPLOAD_ALLOWED_EXTENSIONS=pdf,doc,docx,txt,jpg,jpeg,png
UPLOAD_DIRECTORY=/app/uploads

# ============================================================================
# EMAIL CONFIGURATION (if needed)
# ============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=<SMTP_USERNAME>
SMTP_PASSWORD=<SMTP_PASSWORD>
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@networking-ai.com
SMTP_FROM_NAME=Networking AI

# ============================================================================
# CLOUD PROVIDER SPECIFIC (AWS example)
# ============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<AWS_ACCESS_KEY>
AWS_SECRET_ACCESS_KEY=<AWS_SECRET_KEY>
S3_BUCKET_NAME=networking-ai-uploads-prod

# ============================================================================
# KUBERNETES SPECIFIC
# ============================================================================
POD_NAME=${POD_NAME}
POD_NAMESPACE=${POD_NAMESPACE}
POD_IP=${POD_IP}
K8S_NODE_NAME=${K8S_NODE_NAME}

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=networking-ai-backups-prod

# ============================================================================
# NOTES
# ============================================================================
# 1. Generate secure random keys with: openssl rand -hex 32
# 2. Use different keys for each environment
# 3. Rotate keys regularly (every 90 days recommended)
# 4. Store secrets in AWS Secrets Manager, HashiCorp Vault, or similar
# 5. Never commit this file with actual values to version control
# 6. Use Kubernetes secrets or external secrets operator in production
