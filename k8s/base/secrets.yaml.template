# Secrets Template for Networking AI Platform
# DO NOT commit actual secrets to version control
# Use external secrets operator or kubectl create secret in production

apiVersion: v1
kind: Secret
metadata:
  name: networking-ai-secrets
  namespace: networking-ai
  labels:
    app: networking-ai
type: Opaque
stringData:
  # Database Credentials
  POSTGRES_USER: "<REPLACE_WITH_ACTUAL_VALUE>"
  POSTGRES_PASSWORD: "<REPLACE_WITH_ACTUAL_VALUE>"

  # Redis Credentials
  REDIS_PASSWORD: "<REPLACE_WITH_ACTUAL_VALUE>"

  # API Keys
  ANTHROPIC_API_KEY: "<REPLACE_WITH_ACTUAL_VALUE>"

  # Application Secrets
  SECRET_KEY: "<REPLACE_WITH_ACTUAL_VALUE>"
  JWT_SECRET_KEY: "<REPLACE_WITH_ACTUAL_VALUE>"

  # Monitoring (optional)
  SENTRY_DSN: "<REPLACE_WITH_ACTUAL_VALUE>"

---
# Example: Create secrets from command line
# kubectl create secret generic networking-ai-secrets \
#   --from-literal=POSTGRES_USER=postgres \
#   --from-literal=POSTGRES_PASSWORD=<secure-password> \
#   --from-literal=REDIS_PASSWORD=<secure-password> \
#   --from-literal=ANTHROPIC_API_KEY=<your-api-key> \
#   --from-literal=SECRET_KEY=<secure-random-key> \
#   --from-literal=JWT_SECRET_KEY=<secure-random-key> \
#   --namespace networking-ai

---
