# Anthropic API Configuration
ANTHROPIC_API_KEY=your_api_key_here

# Model Configuration
DEFAULT_MODEL=claude-3-5-sonnet-20241022
MAX_TOKENS=4096
TEMPERATURE=0.7

# Similarity Thresholds
MIN_SIMILARITY_SCORE=0.6
TOP_N_RECOMMENDATIONS=10

# Feature Flags
ENABLE_AI_ANALYSIS=true
ENABLE_CACHING=true

# RAG Configuration
CHROMADB_PATH=./data/chromadb
PUBLIC_KNOWLEDGE_COLLECTION=public_knowledge
PRIVATE_VAULT_COLLECTION=private_vault

# Security & Encryption
ENCRYPTION_KEY=generate_with_cryptography_fernet_key
MASTER_SALT=generate_random_salt_string

# Knowledge Learning
ENABLE_KNOWLEDGE_LEARNING=true
DEDUPLICATION_THRESHOLD=0.95
MIN_INTERACTION_QUALITY_SCORE=0.7

# Account Lifecycle
ACCOUNT_SLEEP_DAYS=365
ACCOUNT_DELETE_DAYS=730

# Agent Configuration
ENABLE_MULTI_AGENT=true
MAX_AGENT_ITERATIONS=10
AGENT_VERBOSE=false

# Redis Configuration (optional for caching)
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600
